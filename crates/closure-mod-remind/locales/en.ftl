module-description = Schedule reminders in this channel.
permission-remind-use = Use reminders.
command-remind = remind
    .description = Manage your reminders
subcommand-remind-add = add
    .description = Schedule a reminder
option-remind-add-when = when
    .description = Relative time from 10 seconds to 30 days
option-remind-add-text = text
    .description = Reminder text, up to 500 characters
subcommand-remind-list = list
    .description = List your pending reminders
subcommand-remind-cancel = cancel
    .description = Cancel a reminder
option-remind-cancel-id = id
