module-description = Commands that tell about the server, a role, a channel or a member, the names a member went by, and finding or moving members in voice.
command-serverinfo = serverinfo
    .description = Show facts about this server
command-roleinfo = roleinfo
    .description = Show facts about a role
option-roleinfo-role = role
    .description = The role
command-channelinfo = channelinfo
    .description = Show facts about a channel
option-channelinfo-channel = channel
    .description = The channel
command-avatar = avatar
    .description = Show the avatar of a member
option-avatar-user = user
    .description = The member; yourself when left out
command-names = names
    .description = Show the names a member went by
option-names-user = user
    .description = The member
command-locate = locate
    .description = Find the voice channel a member is in
option-locate-user = user
    .description = The member
command-vcmove = vcmove
    .description = Move a member to another voice channel
option-vcmove-user = user
    .description = The member, who has to be in voice
option-vcmove-channel = channel
    .description = The voice channel to move them to
command-vckick = vckick
    .description = Disconnect a member from voice
option-vckick-user = user
    .description = The member
command-Info = Info
permission-utility-info = Use the commands that show information
permission-utility-voice = Move and disconnect members in voice
utility-id = ID
utility-created = Created
utility-joined = Joined this server
utility-nick = Nickname
utility-account = Account name
utility-roles = Roles
utility-roles-count = Roles
utility-emojis = Emojis
utility-members = Members
utility-owner = Owner
utility-timeout = Timed out until
utility-bot = Bot
utility-color = Color
utility-position = Position
utility-hoist = Shown apart
utility-mentionable = Can be pinged
utility-managed = Made by an integration
utility-kind = Type
utility-parent = Category
utility-yes = yes
utility-no = no
utility-none = none
utility-no-avatar = That member has no avatar.
utility-names-none = No other names of that member have been seen.
utility-locate-in = { $user } is in { $channel }.
utility-locate-out = { $user } is not in a voice channel, as far as the bot has seen.
utility-moved = Moved { $user } to { $channel }.
utility-disconnected = Disconnected { $user } from voice.
utility-reason-move = Moved by a moderator
utility-reason-kick = Disconnected by a moderator
utility-not-found = That could not be found.
utility-cannot = The bot is not allowed to do that.
utility-unavailable = Discord could not answer that just now. Try again in a moment.
command-findname = findname
    .description = Find the members who went by a name
option-findname-name = name
    .description = A name, exactly as the member had it (case does not matter)
utility-findname-none = No member is known to have gone by that name. Only names seen since this search was added are found.
permission-utility-search = Find members by the names they went by
