utility-names-none = No other names of that member have been seen.
utility-locate-in = { $user } is in { $channel }.
utility-locate-out = { $user } is not in a voice channel, as far as the bot has seen.
utility-moved = Moved { $user } to { $channel }.
utility-disconnected = Disconnected { $user } from voice.
utility-reason-move = Moved by a moderator
utility-reason-kick = Disconnected by a moderator
utility-not-found = That could not be found.
utility-cannot = The bot is not allowed to do that.
utility-unavailable = Discord could not answer that just now. Try again in a moment.
utility-findname-none = No member is known to have gone by that name. Only names seen since this search was added are found.
permission-utility-search = Find members by the names they went by
utility-moveall-same = Pick two different channels.
utility-moved-all = Moved { $moved } to { $channel }; { $left } could not be moved.
utility-reason-hop = Went into voice channels too often
config-utility-voice_hop_limit = How many times a member may go into a voice channel within the window before they are disconnected; 0 sets no limit.
config-utility-voice_hop_seconds = The window of the limit on voice channel moves, in seconds.
command-nickname = nickname
    .description = Change the nickname of a member, or take it off
option-nickname-user = user
    .description = The member
option-nickname-nickname = nickname
    .description = The new nickname; left out, the nickname is taken off
command-snowflake = snowflake
    .description = Tell when a Discord id was made
option-snowflake-id = id
    .description = The id of a user, channel, role, message or the like
utility-reason-nickname = Nickname changed by a moderator
utility-nickname-set = The nickname of { $user } is now { $nickname }.
utility-nickname-reset = The nickname of { $user } is taken off.
utility-snowflake = { $id } was made { $created }.
utility-snowflake-bad = That is not an id.
permission-utility-nickname = Change the nickname of a member
command-info = info
    .description = Show facts about a role, a channel, an invite, a message, an emoji, or this server
option-info-role = role
    .description = A role to tell about
option-info-channel = channel
    .description = A channel to tell about
option-names-name = name
    .description = Instead: find the members who went by this name (case does not matter)
option-vcmove-from = from
    .description = Instead of one member: the voice channel to empty
utility-info-one = Name only one of a role, a channel, an invite, a message or an emoji.
utility-names-one = Name a member or a name to find, not both.
utility-move-one = Name one member, or one voice channel to empty with the channel to move them to.
option-info-invite = invite
    .description = An invite (its link or its code) to look at before anybody follows it
option-info-message = message
    .description = A message of this server (its link) to tell about
option-info-emoji = emoji
    .description = An emoji (written out, or its id) to tell about
