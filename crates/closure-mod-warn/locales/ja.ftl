command-warn = 警告
    .description = メンバーに警告し、警告を確認します
subcommand-warn-add = 追加
    .description = メンバーに警告します
option-warn-add-user = ユーザー
    .description = 警告する相手
option-warn-add-reason = 理由
    .description = 警告の理由
subcommand-warn-list = 一覧
    .description = メンバーの警告を表示します
option-warn-list-user = ユーザー
    .description = 対象のメンバー
subcommand-warn-clear = 全削除
    .description = メンバーの警告をすべて削除します
option-warn-clear-user = ユーザー
    .description = 対象のメンバー
warn-added = { $user } に警告しました (有効 { $active } 件)。{ $days } 日後に失効します。
warn-self = 自分自身に警告することはできません。
warn-full = { $user } には、保存できる警告の上限 ({ $limit } 件) がすでにあります。
warn-none = { $user } に有効な警告はありません。
warn-list =
    { $user } の警告 (有効 { $active } 件、これまでに合計 { $issued } 件):
    { $lines }
warn-line = #{ $id } { $reason } (実行者: { $by })
warn-no-reason = 理由なし
warn-clear-ask = { $user } の警告 { $active } 件をすべて削除しますか？
warn-clear-yes = 削除する
warn-clear-no = やめる
warn-cleared = { $user } の警告を { $count } 件削除しました。
warn-kept = 何も削除しませんでした。
