command-warn = warn
    .description = Warn members and look at their warnings
subcommand-warn-add = add
    .description = Warn a member
option-warn-add-user = user
    .description = Member to warn
option-warn-add-reason = reason
    .description = Why
subcommand-warn-list = list
    .description = Show the warnings of a member
option-warn-list-user = user
    .description = Member
subcommand-warn-clear = clear
    .description = Remove all warnings of a member
option-warn-clear-user = user
    .description = Member
warn-added = Warned { $user } ({ $active } active). It expires in { $days } days.
warn-self = You cannot warn yourself.
warn-full = { $user } already has the most warnings that can be kept ({ $limit }).
warn-none = { $user } has no active warnings.
warn-list =
    Warnings of { $user } ({ $active } active, { $issued } given in all):
    { $lines }
warn-line = #{ $id } { $reason } (by { $by })
warn-no-reason = no reason given
warn-clear-ask = Remove all { $active } warnings of { $user }?
warn-clear-yes = Remove
warn-clear-no = Keep
warn-cleared = Removed { $count } warnings of { $user }.
warn-kept = Nothing was removed.
