config-honeypot-action = What happens to whoever posts in a honeypot channel: ban, kick or timeout.
config-honeypot-delete_hours = How many hours of a banned member's messages are deleted (0 to 168).
config-honeypot-timeout = How long a timeout lasts, such as 1d.
config-honeypot-exempt_users = Accounts that are never punished. The owner, the bot and anyone with moderator powers are never punished.
config-honeypot-exempt_roles = Roles whose members are never punished.
permission-honeypot-manage = Set up the honeypot channels
command-honeypot = honeypot
    .description = Channels where whoever posts is punished at once
subcommand-honeypot-add = add
    .description = Make a channel a honeypot
option-honeypot-add-channel = channel
    .description = The channel
subcommand-honeypot-remove = remove
    .description = Stop treating a channel as a honeypot
option-honeypot-remove-channel = channel
    .description = The channel
subcommand-honeypot-list = list
    .description = The honeypot channels
subcommand-honeypot-create = create
    .description = Make a channel with a warning in it and set it as a honeypot
option-honeypot-create-name = name
    .description = The name of the new channel; left out, a name of the language of the server
honeypot-channel-name = do-not-post
honeypot-topic = Do not write here. Anyone who does is punished automatically (ban, kick or timeout, as set).
honeypot-warning = ⚠️ Do not write in this channel. Anyone who does is punished automatically (ban, kick or timeout, as set).
honeypot-reason = Posted in a honeypot channel
honeypot-reason-create = Honeypot channel made
honeypot-created = Made { $channel } and set it as a honeypot. Anyone who posts there is punished at once; moderators and the owner are not.
honeypot-added = { $channel } is a honeypot now.
honeypot-removed = { $channel } is not a honeypot any more.
honeypot-none = There are no honeypot channels.
honeypot-list = Honeypot channels: { $channels }
honeypot-failed = Could not do that. Try again in a moment.
