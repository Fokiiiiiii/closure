option-vcmute-duration = duration
    .description = How long (1h, 7d) or until (2026-11-01 18:00); until lifted if left out
option-vcmute-reason = reason
    .description = Why
command-vcunmute = vcunmute
    .description = Lift the voice mute of a member
option-vcunmute-user = user
    .description = Member
option-vcunmute-reason = reason
    .description = Why
timeout-role-missing = Set timeout_role in the moderation settings.
voice-role-missing = Set voice_mute_role in the moderation settings.
voice-muted = Muted { $user } in voice — case #{ $number }.
voice-muted-for = Muted { $user } in voice until { $until } — case #{ $number }.
voice-unmuted = Removed the voice mute of { $user } — case #{ $number }.
template-placeholder = Template
template-pick-timeout = Pick a template to time out { $user }.
template-pick-kick = Pick a template to kick { $user }.
template-pick-ban = Pick a template to ban { $user }.
template-pick-vcmute = Pick a template to mute { $user } in voice channels.
duration-required = Give a duration.
template-expired = Expired. Run the command again.
template-gone = That template was removed. Run the command again.
undo-button = Undo
undo-button-warn = Revoke
