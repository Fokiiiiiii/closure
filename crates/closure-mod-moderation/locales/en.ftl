state-active = active
state-revoked = revoked
state-expired = expired
command-timeout = timeout
    .description = Time a member out for a while; Discord allows 28 days at most
option-timeout-user = user
    .description = Member to time out
option-timeout-duration = duration
    .description = How long, such as 1h or 7d; a template may give it when left out
option-timeout-reason = reason
    .description = Why
command-untimeout = untimeout
    .description = Lift the timeout of a member
option-untimeout-user = user
    .description = Member
option-untimeout-reason = reason
    .description = Why
command-kick = kick
    .description = Kick a member from the server
option-kick-user = user
    .description = Member to kick
option-kick-reason = reason
    .description = Why
command-ban = ban
    .description = Ban a member, for good or for a while
option-ban-user = user
    .description = Member to ban
option-ban-reason = reason
    .description = Why
option-ban-duration = duration
    .description = How long the ban lasts, such as 7d; forever when left out
option-ban-delete_days = delete_days
    .description = Days of the member's messages to delete, 0 to 7
command-unban = unban
    .description = Lift the ban of a member
option-unban-user = user
    .description = Member
option-unban-reason = reason
    .description = Why
timeout-too-long = Discord allows a timeout of 28 days at most.
timed-out = Timed out { $user } for { $duration } — case #{ $number }.
untimed-out = Removed the timeout of { $user } — case #{ $number }.
kicked = Kicked { $user } — case #{ $number }.
banned = Banned { $user } — case #{ $number }.
banned-for = Banned { $user } for { $duration } — case #{ $number }.
ban-no-timer = The ban does not end by itself: its timer could not be set.
ban-delete-days-range = The days of messages to delete are 0 to 7.
unbanned = Unbanned { $user } — case #{ $number }.
dm-timed-out = You were timed out in a server for { $duration }. Reason: { $reason }
dm-kicked = You were kicked from a server. Reason: { $reason }
dm-banned = You were banned from a server. Reason: { $reason }
dm-banned-for = You were banned from a server for { $duration }. Reason: { $reason }
escalated = Escalation: { $action } — case #{ $number }.
