module-description = Warn members, note about them, and look at and revoke the cases of a server.
config-moderation-warn_expire_days = After how many days a warning expires.
config-moderation-dm_on_action = Whether the warned member gets a direct message.
config-moderation-require_reason = Whether a warning needs a reason.
config-moderation-ban_delete_days = How many days of the messages of a banned member are deleted.
config-moderation-escalation = What a warning brings about when a member reaches a number of active warnings.
config-moderation-warns = The number of active warnings that triggers the action.
config-moderation-duration = How long, such as 1h or 7d. A timeout needs it; a ban may have it.
config-moderation-timeout_method = How a timeout is given: Discord's timeout, or a role that is taken off when its time is up.
config-moderation-timeout_role = The id of the role a timeout gives, when timeout_method is role.
config-moderation-voice_mute_method = How a voice mute is given: Discord's voice mute, or a role that is taken off when its time is up.
config-moderation-voice_mute_role = The id of the role a voice mute gives, when voice_mute_method is role.
config-moderation-templates = Templates a moderator picks from when a command leaves out the reason or the duration.
config-moderation-templates-timeout = Templates for /timeout. Each needs a duration.
config-moderation-templates-kick = Templates for /kick. A duration is not used.
config-moderation-templates-ban = Templates for /ban.
config-moderation-templates-vcmute = Templates for /vcmute.
config-moderation-template-id = The name of the template; unique within its list.
config-moderation-template-label = The name the moderator sees.
config-moderation-template-reason = The reason the punishment gets. {"{"}user{"}"} stands for the member, {"{"}moderator{"}"} for the moderator and {"{"}server{"}"} for the server.
config-moderation-template-duration = How long, such as 1h or 7d.
command-warn = warn
    .description = Warn a member; the warning expires after a set number of days
option-warn-user = user
    .description = Member to warn
option-warn-reason = reason
    .description = Why
command-note = note
    .description = Add a note about a member that is not a warning
option-note-user = user
    .description = Member the note is about
option-note-text = text
    .description = What to note
command-warnings = warnings
    .description = Show the active warnings of a member
option-warnings-user = user
    .description = Member
command-case = case
    .description = Look at, list and revoke cases
subcommand-case-view = view
    .description = Show a case
option-case-view-number = number
    .description = Number of the case
subcommand-case-list = list
    .description = List the cases of a member, newest first
option-case-list-user = user
    .description = Member
option-case-list-before = before
    .description = Show only the cases numbered below this
subcommand-case-revoke = revoke
    .description = Revoke a case
option-case-revoke-number = number
    .description = Number of the case
option-case-revoke-reason = reason
    .description = Why it is revoked
warned = Warned { $user }: case #{ $number }, { $active } active.
reason-required = A reason is required.
reason-none = no reason given
noted = Noted about { $user } as case #{ $number }.
warnings-none = { $user } has no active warnings.
warnings-header = Active warnings of { $user } ({ $count }):
warnings-line = #{ $number } { $reason } (expires { $expires })
expires-never = never
case-not-found = There is no case #{ $number }.
case-already-revoked = Case #{ $number } was already revoked.
case-revoked = Case #{ $number } was revoked.
case-list-header = Cases of { $user }:
case-list-line = #{ $number } { $kind } { $state } { $reason }
case-list-none = { $user } has no cases.
state-active = active
state-revoked = revoked
state-expired = expired
command-timeout = timeout
    .description = Time a member out for a while; Discord allows 28 days at most
option-timeout-user = user
    .description = Member to time out
option-timeout-duration = duration
    .description = How long (1h, 7d) or until (2026-11-01 18:00); a template may give it
option-timeout-reason = reason
    .description = Why
command-untimeout = untimeout
    .description = Lift the timeout of a member
option-untimeout-user = user
    .description = Member
option-untimeout-reason = reason
    .description = Why
command-kick = kick
    .description = Kick a member from the server
option-kick-user = user
    .description = Member to kick
option-kick-reason = reason
    .description = Why
command-ban = ban
    .description = Ban a member, for good or for a while
option-ban-user = user
    .description = Member to ban
option-ban-reason = reason
    .description = Why
option-ban-duration = duration
    .description = How long (7d) or until (2026-11-01 18:00); forever if left out
option-ban-delete_days = delete_days
    .description = Days of the member's messages to delete, 0 to 7
command-unban = unban
    .description = Lift the ban of a member
option-unban-user = user
    .description = Member
option-unban-reason = reason
    .description = Why
timeout-too-long = Discord allows a timeout of 28 days at most.
timed-out = Timed out { $user } until { $until } — case #{ $number }.
untimed-out = Removed the timeout of { $user } — case #{ $number }.
kicked = Kicked { $user } — case #{ $number }.
banned = Banned { $user } — case #{ $number }.
banned-for = Banned { $user } until { $until } — case #{ $number }.
ban-delete-days-range = Delete days must be 0 to 7.
unbanned = Unbanned { $user } — case #{ $number }.
escalated = Escalation: { $action } — case #{ $number }.
escalation-failed = Escalation to { $action } failed; the warning stands.
escalation-invalid = The rule for { $count } warnings is invalid; skipped.
escalation-reason = { $count ->
    [one] Automatic: { $count } active warning (case #{ $case })
   *[other] Automatic: { $count } active warnings (case #{ $case })
}
escalation-timeout = timed out until { $until }
escalation-kick = kicked
escalation-ban = banned
escalation-ban-for = banned until { $until }
command-vcmute = vcmute
    .description = Mute a member in voice channels, for a while or until it is lifted
option-vcmute-user = user
    .description = Member to mute in voice channels
option-vcmute-duration = duration
    .description = How long (1h, 7d) or until (2026-11-01 18:00); until lifted if left out
option-vcmute-reason = reason
    .description = Why
command-vcunmute = vcunmute
    .description = Lift the voice mute of a member
option-vcunmute-user = user
    .description = Member
option-vcunmute-reason = reason
    .description = Why
timeout-role-missing = Set timeout_role in the moderation settings.
voice-role-missing = Set voice_mute_role in the moderation settings.
voice-muted = Muted { $user } in voice — case #{ $number }.
voice-muted-for = Muted { $user } in voice until { $until } — case #{ $number }.
voice-unmuted = Removed the voice mute of { $user } — case #{ $number }.
template-placeholder = Template
template-pick-timeout = Pick a template to time out { $user }.
template-pick-kick = Pick a template to kick { $user }.
template-pick-ban = Pick a template to ban { $user }.
template-pick-vcmute = Pick a template to mute { $user } in voice channels.
duration-required = Give a duration.
template-expired = Expired. Run the command again.
template-gone = That template was removed. Run the command again.
undo-button = Undo
undo-button-warn = Revoke
undo-by = -# ↩ Undone by { $user }.
undo-reason = Undone from case #{ $case }.
undone-by-button = Undone with its button.
undo-not-needed = That is already over.
undo-superseded = Case #{ $number } revoked. A newer one still applies.
history-line = -# Before this: { $warnings }, { $cases }.
history-warnings = { $count ->
    [one] 1 active warning
   *[other] { $count } active warnings
}
history-cases = { $count ->
    [one] 1 case
   *[other] { $count } cases
}
history-cases-more = { $count }+ cases
this-server = this server
rejoin-timeout = Rejoined while the timeout of case #{ $number } stood
rejoin-voice = Rejoined while the voice mute of case #{ $number } stood
config-moderation-remove_roles_on_mute = Which roles a role timeout or voice mute takes off the member: false, true for every role that can be taken off, or a list of role ids.
config-moderation-restore_roles_on_mute = Which of the roles taken off come back when the punishment ends: the same forms as remove_roles_on_mute. true by default.
permission-moderation-warn = Warn members
permission-moderation-note = Add notes about members
permission-moderation-cases = See the cases and warnings of members
permission-moderation-revoke = Revoke cases
permission-moderation-timeout = Time members out and lift timeouts
permission-moderation-kick = Kick members
permission-moderation-ban = Ban and unban members
permission-moderation-voice = Mute members in voice channels and lift it
permission-moderation-clear = Delete the newest messages of a channel
reason-clear = Cleared with /clear
clear-done = Deleted { $deleted } messages. { $skipped } older than fourteen days were left.
clear-range = Choose from 1 to 100 messages.
command-clear = clear
    .description = Delete the newest messages of the channel
option-clear-count = count
    .description = How many messages, from 1 to 100
