module-description = Roles that members take themselves, and roles that moderators hand out.
command-role = role
    .description = Take, leave and hand out roles
subcommand-role-join = join
    .description = Take a role from the list
subcommand-role-leave = leave
    .description = Leave a role you took
subcommand-role-list = list
    .description = Show the roles you can take
subcommand-role-give = give
    .description = Give a role to a member
subcommand-role-take = take
    .description = Take a role from a member
option-role-join-role = role
    .description = The role
option-role-leave-role = role
    .description = The role
option-role-give-user = user
    .description = The member
option-role-give-role = role
    .description = The role
option-role-take-user = user
    .description = The member
option-role-take-role = role
    .description = The role
permission-roles-self = Take and leave the roles the server listed
permission-roles-manage = Give roles to members and take them back
config-roles-self_roles = The roles members may take for themselves, with a command, a button or a reaction.
config-roles-reaction_roles = Reactions that give a role: the message, the emoji and the role.
roles-reason-self = A member took or left the role themselves
roles-reason-reaction = A reaction on a role message
roles-reason-moderator = Given by { $moderator }
roles-joined = You now have { $role }.
roles-left = You no longer have { $role }.
roles-given = { $user } now has { $role }.
roles-taken = { $user } no longer has { $role }.
roles-list-empty = The server has not listed any roles to take.
roles-not-listed = That role is not one members may take themselves.
roles-too-high = You can only hand out roles below your highest role.
roles-cannot = The bot cannot change that role. It must sit below the bot's own role.
roles-not-found = That role does not exist.
roles-unavailable = Could not change the role right now. Try again in a moment.
command-pingrole = pingrole
    .description = Let a role be pinged for a minute
option-pingrole-role = role
    .description = The role
permission-roles-ping = Let a pingable role be pinged for a minute
config-roles-pingable_roles = Roles that can be pinged for a minute with /pingrole. They are not pingable otherwise.
roles-reason-ping = A member asked to ping the role
roles-reason-ping-end = The minute to ping the role is over
roles-pingable = { $role } can be pinged for the next minute.
roles-not-pingable = That role is not one that can be pinged this way.
roles-restricted = That role belongs to a punishment, which gives it and takes it off. It cannot be handed out or taken by hand.
