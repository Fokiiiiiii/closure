TICKETS_EMAIL_SMTP_USERNAME=
TICKETS_EMAIL_SMTP_PASSWORD=
TICKETS_EMAIL_FROM=
# Public HTTPS origin of the Dashboard for token-free authenticated ticket history links.
CLOSURE_DASHBOARD_BASE_URL=
