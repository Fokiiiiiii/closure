DISCORD_TOKEN=
DISCORD_APPLICATION_ID=
DISCORD_PUBLIC_KEY=
TEST_GUILD_ID=
DATABASE_URL=postgres://localhost:5432/closure_dev
# Comma-separated platform moderator user IDs; empty disables Gallery review.
CLOSURE_GALLERY_MODERATORS=
# Optional transactional notifications. Email needs the vault key and a TLS-protected SMTP server.
INTEGRATION_SECRETS_MASTER_KEY=
TICKETS_EMAIL_SMTP_HOST=
TICKETS_EMAIL_SMTP_PORT=587
TICKETS_EMAIL_SMTP_USERNAME=
TICKETS_EMAIL_SMTP_PASSWORD=
TICKETS_EMAIL_FROM=
# Public HTTPS origin of the Dashboard for token-free authenticated ticket history links.
CLOSURE_DASHBOARD_BASE_URL=
# One named Discord webhook per variable: WEBHOOK_<NAME>=<URL> (the name is what log_webhook refers to).
WEBHOOK_EXAMPLE=https://discord.com/api/webhooks/123456789012345678/FAKE_TOKEN_REPLACE_ME
